@prefix trowel-master: <https://github.com/tylorismusic-commits/trowel-master> .

<https://github.com/tylorismusic-commits/trowel-master>
	a lv2:Plugin , lv2:EQPlugin ;
	lv2:binary <trowel-master.so> ;
	lv2:majorVersion 0 ;
	lv2:minorVersion 2 ;
	lv2:microVersion 0 ;
	lv2:project <https://github.com/tylorismusic-commits/trowel> ;
	lv2:optionalFeature lv2:hardRTCapable ;
	doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
	doap:name "Trowel Master" ;
	doap:description "Mastering EQ suite: Pultec-style colour, 4000E console EQ and a 4096-point spectral resonance suppressor." ;
	doap:shortdesc "Mastering EQ suite: Pultec-style colour, 4000E console EQ and a 4096-point spectral resonance suppressor." ;
	foaf:homepage <https://github.com/tylorismusic-commits/trowel> ;
	ui:ui <https://github.com/tylorismusic-commits/trowel-master#ui> ;
