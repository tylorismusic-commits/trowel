@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/tylorismusic-commits/trowel#preset_vocal> a pset:Preset ;
	lv2:appliesTo <https://github.com/tylorismusic-commits/trowel> ;
	rdfs:label "Vocal - Air & Tame" ;
	lv2:port [ lv2:symbol "pultec_on" ; lv2:value 1 ] ;
	lv2:port [ lv2:symbol "pul_low_freq" ; lv2:value 100 ] ;
	lv2:port [ lv2:symbol "pul_low_boost" ; lv2:value 1.5 ] ;
	lv2:port [ lv2:symbol "pul_low_cut" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "pul_high_freq" ; lv2:value 12000 ] ;
	lv2:port [ lv2:symbol "pul_high_boost" ; lv2:value 2 ] ;
	lv2:port [ lv2:symbol "pul_bandwidth" ; lv2:value 6 ] ;
	lv2:port [ lv2:symbol "pul_high_cut_freq" ; lv2:value 10000 ] ;
	lv2:port [ lv2:symbol "pul_high_cut" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "pul_iron" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "ssl_on" ; lv2:value 1 ] ;
	lv2:port [ lv2:symbol "ssl_lf_freq" ; lv2:value 90 ] ;
	lv2:port [ lv2:symbol "ssl_lf_gain" ; lv2:value -1 ] ;
	lv2:port [ lv2:symbol "ssl_lf_bell" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "ssl_lmf_freq" ; lv2:value 300 ] ;
	lv2:port [ lv2:symbol "ssl_lmf_gain" ; lv2:value -2 ] ;
	lv2:port [ lv2:symbol "ssl_hmf_freq" ; lv2:value 3000 ] ;
	lv2:port [ lv2:symbol "ssl_hmf_gain" ; lv2:value 1.5 ] ;
	lv2:port [ lv2:symbol "ssl_hf_freq" ; lv2:value 10000 ] ;
	lv2:port [ lv2:symbol "ssl_hf_gain" ; lv2:value 1 ] ;
	lv2:port [ lv2:symbol "ssl_hf_bell" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "ssl_hpf" ; lv2:value 80 ] ;
	lv2:port [ lv2:symbol "ssl_lpf" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "tame_on" ; lv2:value 1 ] ;
	lv2:port [ lv2:symbol "tame_amount" ; lv2:value 35 ] ;
	lv2:port [ lv2:symbol "tame_focus" ; lv2:value 60 ] ;
	lv2:port [ lv2:symbol "tame_selectivity" ; lv2:value 55 ] ;
	lv2:port [ lv2:symbol "tame_sensitivity" ; lv2:value 55 ] ;
	lv2:port [ lv2:symbol "tame_attack" ; lv2:value 10 ] ;
	lv2:port [ lv2:symbol "tame_release" ; lv2:value 250 ] ;
	lv2:port [ lv2:symbol "tame_mix" ; lv2:value 100 ] ;
	lv2:port [ lv2:symbol "tame_listen" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "input_gain" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "output_gain" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "routing" ; lv2:value 0 ] ;
	lv2:port [ lv2:symbol "enable" ; lv2:value 1 ] .

